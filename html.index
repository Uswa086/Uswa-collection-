
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Uswa's Collection | Unstitched Fabrics</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation -->
    <header>
        <div class="logo">Uswa's <span>Collection</span></div>

        <nav>
            <a href="#home">Home</a>
            <a href="#ladies">Ladies</a>
            <a href="#gents">Gents</a>
            <a href="#contact">Contact</a>
        </nav>

        <a href="#cart" class="cart-btn">
            🛒 Cart (<span id="cart-count">0</span>)
        </a>
    </header>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <p class="tagline">PREMIUM UNSTITCHED COLLECTION</p>
            <h1>Discover Your Perfect Fabric</h1>
            <p>Beautiful fabrics for ladies and gents, selected
               according to quality, style and elegance.</p>

            <a href="#ladies" class="btn">Shop Ladies</a>
            <a href="#gents" class="btn btn-light">Shop Gents</a>
        </div>
    </section>

    <!-- Ladies Collection -->
    <section class="products-section" id="ladies">
        <h2>Ladies Collection</h2>
        <p class="section-desc">Explore our beautiful fabric variety</p>
        <div class="product-grid" id="ladies-products"></div>
    </section>

    <!-- Gents Collection -->
    <section class="products-section gents-section" id="gents">
        <h2>Gents Collection</h2>
        <p class="section-desc">Quality fabrics for every occasion</p>
        <div class="product-grid" id="gents-products"></div>
    </section>

    <!-- Shopping Cart -->
    <section class="cart-section" id="cart">
        <h2>Your Shopping Cart</h2>
        <div id="cart-items">
            <p>Your cart is empty.</p>
        </div>
        <h3>Total: Rs. <span id="cart-total">0</span></h3>
        <button class="btn" onclick="checkoutWhatsApp()">
            Buy Now / Order on WhatsApp
        </button>
    </section>

    <!-- About Us -->
    <section class="about-section" id="about">
        <h2>About Us</h2>
        <p>
            Welcome to Uswa's Collection! We offer a variety of
            unstitched fabrics for ladies and gents. Our goal is
            to bring you beautiful designs and quality fabrics.
        </p>
        <p>Location: Khanewal, Kacha Khu, Pakistan</p>
    </section>

    <!-- Contact -->
    <section class="contact-section" id="contact">
        <h2>Contact Us</h2>
        <p>Have a question or want to place an order?</p>

        <a href="https://wa.me/923157540218"
           target="_blank" class="btn">
            Chat on WhatsApp
        </a>

        <a href="mailto:uswanazish311@gmail.com"
           class="btn btn-light">
            Send an Email
        </a>

        <p>WhatsApp: 03157540218</p>
        <p>Email: uswanazish311@gmail.com</p>
        <p>Payment: Cash on Delivery, Easypaisa, JazzCash,
           Bank Transfer</p>
    </section>

    <!-- Footer -->
    <footer>
        <h3>Uswa's Collection</h3>
        <p>Premium Unstitched Fabrics for Ladies & Gents</p>
        <p>© 2026 Uswa's Collection. All Rights Reserved.</p>
    </footer>

    <a class="floating-whatsapp"
       href="https://wa.me/923157540218"
       target="_blank" aria-label="Contact us on WhatsApp">☏</a>

    <script src="script.js"></script>
</body>
</html>
